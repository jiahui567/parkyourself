{
  "expo": {
    "name": "Park Yourself",
    "slug": "park-yourself",
    "version": "1.0.0",
    "scheme": "parkyourself",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.parkyourself.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E1013",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "customBuildFlags": "-DSQLITE_DEFAULT_FOREIGN_KEYS=1"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      "./plugins/withCmakeVersion",
      "./plugins/withImageColorsJvmTarget",
      "./plugins/withNoDeviceTransfer",
      "expo-mlkit-ocr",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Park Yourself uses your location while you park, to fill in the place and save where the car is.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0E1013"
        }
      ]
    ]
  }
}
