# Which Supabase server a build uses. Two git-ignored copies of this file:
#   .env.development.local  development builds (npx expo start / run:android): keep one block uncommented,
#                           then fully reload the app.
#   .env.production.local   release builds (npm run release): the hosted block. The release app downloads
#                           the public car park list from it once a day (PLAN.md, M12).
# Never put a secret key (sb_secret_...) or the database password here: EXPO_PUBLIC_ values are inside the app.

# Local Supabase (Docker, `npx supabase start`). The phone reaches it after `adb reverse tcp:54321 tcp:54321`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Hosted dev. Publishable key from the dashboard: Project Settings > API Keys.
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
